---
import InnerLayout from '../layouts/InnerLayout.astro';
import FeatureTour, { type Feature } from '../components/FeatureTour.astro';
import ZoneRecovery from '../components/ZoneRecovery.astro';

const features: Feature[] = [
  {
    id: 'today', title: 'Today', line: 'The day at a glance', path: '/today',
    video: 'today.mp4', image: 'today-poster.webp', phone: 'today-phone.webp',
    alt: 'The Today page: confirming a finished visit as done from the timeline',
    body: 'Today is the first page an owner sees after signing in. It shows the day\'s visits, what each person is working on, and a list of loose ends that need someone to act. A finished visit is confirmed as done, skipped, or no-show with one tap, from a desktop or a phone.',
  },
  {
    id: 'recurring', title: 'Recurring work', line: 'Define a schedule once', path: '/jobs/new',
    video: 'recurrence.mp4', image: 'recurrence-poster.webp',
    alt: 'Building a weekly Monday, Wednesday and Friday schedule on a new job',
    body: 'A repeating job is stored once as a series with a recurrence rule. Each date the rule produces shows up on the calendar and on Today without being saved as its own record until someone changes, confirms, or invoices it.',
  },
  {
    id: 'calendar', title: 'Calendar', line: 'Five views, one schedule', path: '/calendar',
    video: 'calendar.mp4', image: 'calendar-poster.webp',
    alt: 'Dragging a recurring series to a new time on the week view',
    body: 'Day, week, month, resource, and list views all read from the same schedule. Dragging a visit can move just that date or the whole series, including moving it to a different day of the week.',
  },
  {
    id: 'invoicing', title: 'Monthly invoicing', line: 'A month of work, one invoice', path: '/invoices',
    video: 'invoice.mp4', image: 'invoice-poster.webp',
    alt: 'Reviewing drafted monthly invoices and issuing them in one batch',
    body: 'On the billing day, Daybourne drafts one invoice per client from the month\'s confirmed visits. The owner reviews the drafts, issues them in a batch, and records payments as they arrive, so client balances stay current.',
  },
  {
    id: 'expenses', title: 'Expenses & mileage', line: 'The cost side of the books', path: '/expenses',
    image: 'expenses.webp', phone: 'expense-capture.webp',
    alt: 'The expenses list by month, with the quick-capture receipt form on a phone',
    body: 'Expenses are recorded against Schedule C categories, so the Profit & Loss report lines up with the owner\'s tax return. Quick capture on a phone saves the receipt photo right away and leaves the amount and category for later.',
  },
  {
    id: 'import', title: 'Client import', line: 'Bring the client list along', path: '/settings/import-clients',
    image: 'import.webp',
    alt: 'Matching spreadsheet columns to client fields during an import',
    body: 'Owners can bring their client list over from a spreadsheet or a QuickBooks Online export. The importer recognizes common column names, flags phone numbers it cannot read, and catches duplicates before anything is saved.',
  },
  {
    id: 'messaging', title: 'Client messaging', line: 'Reminders without the 6 a.m. text', path: '/settings/notifications',
    image: 'messaging.webp',
    alt: 'Notification delivery rules: sender identity, send window and protected contact hours',
    body: 'Reminders and schedule changes go out to clients automatically. Quiet hours, a daily cap per client, and fixed contact hours in each client\'s own timezone keep a business from messaging people at night.',
  },
  {
    id: 'help', title: 'In-app help', line: 'Documentation that ships with the code', path: '/settings/invoicing',
    image: 'help.webp',
    alt: 'The help panel open beside the invoicing settings, explaining the billing day',
    body: 'Every screen has a help guide that opens beside the work. The screenshots and clips in those guides, including every one on this page, are captured automatically by Playwright against a seeded demo business.',
  },
];

// ── Forex chart — rendered to static SVG at build time ─────────
// The previous version drew this at runtime with lightweight-charts
// from a CDN, which silently failed under client-side navigation.
// Same seeded data, now baked into the HTML so it always renders.
function lcg(seed: number) {
  let s = seed >>> 0;
  return () => {
    s = (Math.imul(s, 1664525) + 1013904223) >>> 0;
    return s / 4294967296;
  };
}

const rand = lcg(2741);
const PERIOD = 20;
const BARS = 90;

interface Bar { o: number; h: number; l: number; c: number; }
const bars: Bar[] = [];
const closes: number[] = [];
let close = 0.9215;

for (let k = 0; k < BARS; k++) {
  const t = (k + 1) / BARS;
  const drift = 0.0002 * Math.sin(t * Math.PI * 2.8 + 0.5) - 0.00008;
  const noise = (rand() - 0.5) * 0.0042;
  const o = close;
  close = Math.max(0.888, Math.min(0.958, o + drift + noise));
  const body = Math.abs(close - o);
  const h = Math.max(o, close) + rand() * (body * 0.6 + 0.0009);
  const l = Math.min(o, close) - rand() * (body * 0.6 + 0.0009);
  bars.push({ o, h, l, c: close });
  closes.push(close);
}

const ma: (number | null)[] = closes.map((_, n) =>
  n + 1 >= PERIOD
    ? closes.slice(n + 1 - PERIOD, n + 1).reduce((a, b) => a + b, 0) / PERIOD
    : null
);

const CW = 600, CH = 440, PX = 10, PT = 30, PB = 20;
const hiAll = Math.max(...bars.map(b => b.h));
const loAll = Math.min(...bars.map(b => b.l));
const py = (p: number) => +(PT + ((hiAll - p) / (hiAll - loAll)) * (CH - PT - PB)).toFixed(1);
const step = (CW - 2 * PX) / BARS;
const bodyW = +(step * 0.62).toFixed(1);

const candles = bars.map((b, k) => {
  const cx = +(PX + step * (k + 0.5)).toFixed(1);
  return {
    cx,
    x: +(cx - bodyW / 2).toFixed(1),
    yBody: py(Math.max(b.o, b.c)),
    hBody: Math.max(1.5, +Math.abs(py(b.o) - py(b.c)).toFixed(1)),
    yHi: py(b.h),
    yLo: py(b.l),
    up: b.c >= b.o,
  };
});

const maPoints = ma
  .map((v, k) => (v == null ? null : `${(PX + step * (k + 0.5)).toFixed(1)},${py(v)}`))
  .filter(Boolean)
  .join(' ');

// Trend-crossing markers, same rule the live system used
const markers: { points: string; color: string; k: number }[] = [];
for (let k = PERIOD; k < BARS; k++) {
  const prevMa = ma[k - 1], curMa = ma[k];
  if (prevMa == null || curMa == null) continue;
  const c = candles[k];
  if (closes[k - 1] < prevMa && closes[k] > curMa) {
    const yy = c.yLo + 5;
    markers.push({ points: `${c.cx},${yy} ${+(c.cx - 4).toFixed(1)},${+(yy + 8).toFixed(1)} ${+(c.cx + 4).toFixed(1)},${+(yy + 8).toFixed(1)}`, color: '#2DD4BF', k });
  } else if (closes[k - 1] > prevMa && closes[k] < curMa) {
    const yy = c.yHi - 5;
    markers.push({ points: `${c.cx},${yy} ${+(c.cx - 4).toFixed(1)},${+(yy - 8).toFixed(1)} ${+(c.cx + 4).toFixed(1)},${+(yy - 8).toFixed(1)}`, color: '#F87171', k });
  }
}

const gridY = [0, 1, 2, 3, 4].map(i => +(PT + (i * (CH - PT - PB)) / 4).toFixed(1));
const gridX = [15, 30, 45, 60, 75].map(i => +(PX + step * i).toFixed(1));
---
<InnerLayout
  title="Portfolio"
  activePage="portfolio"
  description="Selected projects by Michael A. Bos — including Daybourne, a recurring-service management platform for small businesses, and an autonomous forex algorithmic trading system."
>
  <style is:global>
    .port-intro {
      max-width: 1280px;
      margin: 32px auto 0;
      padding: 0 24px;
    }
    .port-intro .eyebrow { margin-bottom: 12px; }
    .port-intro h1 {
      font-family: var(--font-sans);
      font-size: 56px;
      font-weight: var(--fw-medium);
      letter-spacing: -0.025em;
      line-height: 1;
      color: var(--ink-900);
      margin: 0 0 18px;
    }
    .port-intro .dek {
      max-width: 68ch;
      color: var(--ink-700);
      font-size: var(--fs-16);
      line-height: 1.55;
      text-wrap: pretty;
      margin: 0;
    }

    .port-grid {
      max-width: 1280px;
      margin: 64px auto 0;
      padding: 0 24px;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
    }

    .port-card {
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    .port-card-body {
      padding: 28px 28px 24px;
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .port-card .idn {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: var(--rust);
    }
    .port-card .title {
      font-family: var(--font-display);
      font-weight: var(--fw-medium);
      font-size: 20px;
      letter-spacing: -0.015em;
      color: var(--ink-900);
    }
    .port-card .blurb {
      font-size: var(--fs-14);
      line-height: 1.55;
      color: var(--ink-700);
      text-wrap: pretty;
      flex: 1;
    }
    .port-card-footer {
      padding: 14px 28px;
      border-top: 1px solid var(--card-border);
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .port-card-footer .status {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
    }
    .port-card-footer .status.wip { color: var(--rust); }
    .port-card-footer .status.planned { color: var(--ink-500); }

    /* ── Daybourne featured project ──────────────────────────── */
    .featured-wrap {
      max-width: 1280px;
      margin: 56px auto 0;
      padding: 0 24px;
    }
    .featured-label {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: #5C6B3E;
      margin-bottom: 16px;
    }
    .featured-card {
      background: var(--card-bg);
      border: 1px solid rgba(92, 107, 62, 0.25);
      border-top: 3px solid #5C6B3E;
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
    }
    .featured-content {
      padding: 40px 44px 28px;
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      column-gap: 48px;
      row-gap: 0;
    }
    .featured-identity {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 6px;
    }
    .featured-icon {
      width: 32px;
      height: 36px;
      flex-shrink: 0;
    }
    .featured-appname {
      font-family: var(--font-display);
      font-size: var(--fs-24);
      font-weight: var(--fw-semibold);
      letter-spacing: -0.02em;
      color: var(--canyon-ink);
      line-height: 1;
    }
    .featured-tagline {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: #6E7E4D;
      margin-bottom: 20px;
    }
    .featured-desc {
      font-size: var(--fs-16);
      line-height: 1.6;
      color: var(--canyon-shadow);
      text-wrap: pretty;
      margin: 0 0 16px;
    }
    .featured-side {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      gap: 20px;
    }
    .featured-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }
    .stack-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 26px;
      padding: 0 12px;
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      font-weight: var(--fw-medium);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-radius: var(--r-sm);
      border: 1px solid rgba(92, 107, 62, 0.22);
      background: rgba(244, 245, 236, 0.7);
      color: #4C5933;
      white-space: nowrap;
    }
    .featured-footer {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .featured-footer .pill.active {
      color: #5A7A3E;
      border-color: #CFDDB4;
      background: #E5EDD6;
    }
    .featured-footer .pill.active .dot { background: #5A7A3E; }
    .featured-status {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: #6E7E4D;
    }
    .case-link {
      margin-left: auto;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      height: 36px;
      padding: 0 16px;
      border-radius: var(--r-pill);
      background: #5C6B3E;
      color: #F4F5EC;
      font-family: var(--font-display);
      font-size: 14px;
      font-weight: var(--fw-semibold);
      text-decoration: none;
      transition: background 200ms var(--ease-out);
    }
    .case-link svg { transition: transform 200ms var(--ease-out); }
    .case-link:hover { background: #4C5933; color: #F4F5EC; text-decoration: none; }
    .case-link:hover svg { transform: translateX(3px); }
    .case-link:focus-visible { outline: 2px solid #5C6B3E; outline-offset: 3px; }
    .featured-tour {
      padding: 28px 44px 36px;
      border-top: 1px solid rgba(92, 107, 62, 0.15);
      background: linear-gradient(180deg, rgba(244, 245, 236, 0.55), rgba(244, 245, 236, 0) 240px);
    }
    .featured-tour-head {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: #6E7E4D;
      margin-bottom: 18px;
    }

    @media (max-width: 900px) {
      .featured-content { grid-template-columns: 1fr; padding: 28px 24px 20px; }
      .featured-side { margin-top: 8px; }
      .featured-tour { padding: 22px 24px 28px; }
      .case-link { margin-left: 0; }
    }

    /* ── Forex Algo Trader featured project ──────────────────────── */
    .forex-wrap { margin-top: 40px; }
    .forex-label {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: #0D9488;
      margin-bottom: 16px;
    }
    .forex-card {
      background: var(--card-bg);
      border: 1px solid rgba(20, 184, 166, 0.22);
      border-top: 3px solid #0D9488;
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-sm);
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr 1fr;
      min-height: 440px;
    }
    .forex-content {
      padding: 40px 44px;
      display: flex;
      flex-direction: column;
    }
    .forex-identity { margin-bottom: 6px; }
    .forex-appname {
      font-family: var(--font-display);
      font-size: var(--fs-24);
      font-weight: var(--fw-semibold);
      letter-spacing: -0.02em;
      color: var(--ink-900);
      line-height: 1;
    }
    .forex-tagline {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: #0D9488;
      margin: 0 0 20px;
    }
    .forex-desc {
      font-size: var(--fs-16);
      line-height: 1.6;
      color: var(--ink-700);
      text-wrap: pretty;
      margin: 0 0 28px;
    }
    .forex-stack {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-bottom: 28px;
    }
    .forex-chip {
      display: inline-flex;
      align-items: center;
      height: 26px;
      padding: 0 12px;
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      font-weight: var(--fw-medium);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      border-radius: var(--r-sm);
      border: 1px solid rgba(20, 184, 166, 0.25);
      background: rgba(204, 251, 241, 0.5);
      color: #0F766E;
      white-space: nowrap;
    }
    .forex-footer {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-top: auto;
      padding-top: 24px;
      border-top: 1px solid rgba(20, 184, 166, 0.15);
    }
    .forex-status {
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: #0D9488;
    }
    .forex-chart-panel {
      position: relative;
      overflow: hidden;
      background: #0B1426;
      border-left: 1px solid rgba(20, 184, 166, 0.18);
    }
    .forex-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
    }
    /* Replay: candles grow in left to right, the MA draws behind them.
       Only armed by JS (and never under reduced motion), so the chart is
       fully visible without scripts. */
    .forex-chart-panel.armed .cdl,
    .forex-chart-panel.armed .mk { opacity: 0; }
    .forex-chart-panel.armed .ma { stroke-dasharray: 1; stroke-dashoffset: 1; }
    .forex-chart-panel.play .cdl {
      transform-box: fill-box;
      transform-origin: center;
      animation: cdl-in 320ms cubic-bezier(0.2, 0.7, 0.1, 1) both;
      animation-delay: calc(var(--i) * 30ms);
    }
    .forex-chart-panel.play .mk {
      transform-box: fill-box;
      transform-origin: center;
      animation: mk-in 420ms cubic-bezier(0.3, 1.6, 0.5, 1) both;
      animation-delay: calc(var(--i) * 30ms + 220ms);
    }
    .forex-chart-panel.play .ma {
      animation: ma-draw var(--ma-dur) linear both;
      animation-delay: var(--ma-delay);
    }
    @keyframes cdl-in { from { opacity: 0; transform: scaleY(0.15); } to { opacity: 1; transform: none; } }
    @keyframes mk-in { from { opacity: 0; transform: scale(0.2); } to { opacity: 1; transform: none; } }
    @keyframes ma-draw { to { stroke-dashoffset: 0; } }
    .forex-replay {
      position: absolute;
      right: 12px;
      bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      height: 28px;
      padding: 0 11px;
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: #99F6E4;
      background: rgba(11, 20, 38, 0.8);
      border: 1px solid rgba(45, 212, 191, 0.3);
      border-radius: var(--r-sm);
      cursor: pointer;
    }
    .forex-replay:hover { background: rgba(45, 212, 191, 0.14); }
    .forex-replay:focus-visible { outline: 2px solid #2DD4BF; outline-offset: 2px; }
    .forex-watermark {
      position: absolute;
      top: 12px;
      left: 14px;
      font-family: var(--font-mono);
      font-size: var(--fs-11);
      letter-spacing: var(--tr-caps);
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.22);
      pointer-events: none;
    }

    @media (max-width: 900px) {
      .forex-card { grid-template-columns: 1fr; }
      .forex-chart-panel {
        height: 240px;
        border-left: none;
        border-top: 1px solid rgba(20, 184, 166, 0.18);
        order: -1;
      }
      .forex-content { padding: 28px 24px; }
    }

    @media (max-width: 900px) {
      .port-intro h1 { font-size: 40px; }
      .port-grid { grid-template-columns: 1fr; }
    }
  </style>

  <header class="port-intro">
    <div class="eyebrow">Portfolio</div>
    <h1>Selected work.</h1>
    <p class="dek">
      A few things I've worked on to build my skills and challenge myself.
    </p>
  </header>

  <section class="featured-wrap" id="daybourne" aria-label="Featured project">
    <div class="featured-label">Side project · In progress</div>
    <div class="featured-card">
      <div class="featured-content">
        <div>
          <div class="featured-identity">
            <img src="/daybourne-mark.svg" alt="" class="featured-icon" />
            <span class="featured-appname">Daybourne</span>
          </div>
          <div class="featured-tagline">Recurring service management · Private beta in preparation</div>
          <p class="featured-desc">
            Daybourne runs the business side of recurring service work for owner-operators
            with one to three people, such as pool service companies and music teachers.
            It keeps the schedule, the client list, client messages, invoices, and expenses
            in one place, and it is designed for the owner who does the work during the day
            and the paperwork at night.
          </p>
          <p class="featured-desc">
            I am building it by myself. Claude Code agents write much of the code, and
            they work inside a product, design, and review process that I set up for the
            project. The case study covers how that process works.
          </p>
        </div>
        <div class="featured-side">
          <div class="featured-stack">
            <span class="stack-chip">PHP 8.4 / Symfony</span>
            <span class="stack-chip">API Platform</span>
            <span class="stack-chip">PostgreSQL</span>
            <span class="stack-chip">RabbitMQ</span>
            <span class="stack-chip">Keycloak SSO</span>
            <span class="stack-chip">React 19 SPA</span>
            <span class="stack-chip">Expo / React Native</span>
            <span class="stack-chip">Go CLI</span>
            <span class="stack-chip">Playwright</span>
            <span class="stack-chip">OpenTelemetry</span>
            <span class="stack-chip">Claude Code</span>
          </div>
          <div class="featured-footer">
            <span class="pill active"><span class="dot"></span>Active</span>
            <span class="featured-status">In progress</span>
            <a class="case-link" href="/portfolio/daybourne">
              Read the case study
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
      <div class="featured-tour">
        <div class="featured-tour-head">A tour of the app · Demo data</div>
        <FeatureTour features={features} />
      </div>
    </div>
  </section>

  <section class="featured-wrap forex-wrap" id="forex" aria-label="Forex Algo Trader project">
    <div class="forex-label">Algorithmic trading · Archived</div>
    <div class="forex-card">
      <div class="forex-content">
        <div class="forex-identity">
          <span class="forex-appname">Forex Algo Trader</span>
        </div>
        <p class="forex-tagline">Autonomous trend-following · Live forex via Oanda API</p>
        <p class="forex-desc">
          Autonomous trend-following system for live forex trading via the Oanda API.
          Evaluates Heiken Ashi candles, 20-period moving averages, and Renko charts for market entry.
          Implements Zone Recovery — a counter-trend hedging strategy that layers opposing orders
          to recover from losing positions without closing at a loss.
        </p>
        <div class="forex-stack">
          <span class="forex-chip">PHP / Symfony</span>
          <span class="forex-chip">Oanda API</span>
          <span class="forex-chip">Heiken Ashi</span>
          <span class="forex-chip">Zone Recovery</span>
          <span class="forex-chip">Renko Charts</span>
          <span class="forex-chip">20-Period MA</span>
        </div>
        <div class="forex-footer">
          <span class="pill"><span class="dot"></span>Archived</span>
          <span class="forex-status">No longer maintained</span>
        </div>
      </div>
      <div class="forex-chart-panel" data-forex style={`--ma-delay:${PERIOD * 30}ms; --ma-dur:${(BARS - PERIOD) * 30 + 320}ms`}>
        <svg
          class="forex-svg"
          viewBox={`0 0 ${CW} ${CH}`}
          preserveAspectRatio="none"
          role="img"
          aria-label="Simulated USD/EUR daily candlestick chart with a 20-period moving average and trend-crossing entry markers"
        >
          {gridY.map(gy => (
            <line x1={PX} x2={CW - PX} y1={gy} y2={gy} stroke="rgba(255,255,255,0.05)" vector-effect="non-scaling-stroke" />
          ))}
          {gridX.map(gx => (
            <line x1={gx} x2={gx} y1={PT} y2={CH - PB} stroke="rgba(255,255,255,0.04)" vector-effect="non-scaling-stroke" />
          ))}
          {candles.map((c, k) => (
            <g class="cdl" style={`--i:${k}`}>
              <line
                x1={c.cx} x2={c.cx} y1={c.yHi} y2={c.yLo}
                stroke={c.up ? '#2DD4BF' : '#F87171'}
                stroke-width="1"
                vector-effect="non-scaling-stroke"
              />
              <rect x={c.x} y={c.yBody} width={bodyW} height={c.hBody} fill={c.up ? '#2DD4BF' : '#F87171'} />
            </g>
          ))}
          <polyline class="ma" pathLength="1" points={maPoints} fill="none" stroke="#FBBF24" stroke-width="1.2" vector-effect="non-scaling-stroke" />
          {markers.map(m => (
            <polygon class="mk" style={`--i:${m.k}`} points={m.points} fill={m.color} />
          ))}
        </svg>
        <div class="forex-watermark">USD/EUR · Daily · 20-MA</div>
        <button type="button" class="forex-replay" data-forex-replay hidden>
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/></svg>
          Replay
        </button>
      </div>
    </div>
    <ZoneRecovery />
  </section>

  <script>
    function initForex() {
      const panel = document.querySelector<HTMLElement>('[data-forex]');
      if (!panel || panel.dataset.ready) return;
      panel.dataset.ready = '1';
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      const btn = panel.querySelector<HTMLButtonElement>('[data-forex-replay]')!;
      const play = () => {
        panel.classList.remove('play');
        void panel.offsetWidth; // restart the CSS animations
        panel.classList.add('play');
      };
      panel.classList.add('armed');
      btn.hidden = false;
      btn.addEventListener('click', play);
      const io = new IntersectionObserver(([e]) => {
        if (e.isIntersecting) { play(); io.disconnect(); }
      }, { threshold: 0.45 });
      io.observe(panel);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    }
    document.addEventListener('astro:page-load', initForex);
  </script>

